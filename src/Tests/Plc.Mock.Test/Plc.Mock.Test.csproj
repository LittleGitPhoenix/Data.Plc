<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<RootNamespace>Phoenix.Data.Plc.Mock.Test</RootNamespace>
		<AssemblyName>Phoenix.Data.Plc.Mock.Test</AssemblyName>
		<Authors>Felix Leistner</Authors>
		<Company>Little Phoenix</Company>
		
		<!--
		# ╔═══════════════════════════════╗
		# ║ Microsoft Test Platform (MTP) ║
		# ╚═══════════════════════════════╝
		-->
		<!-- Activates the NUnit runner extension inside MTP. This extension generates a Main method and allows the test project to run as a standalone executable if OutputType is also enabled. -->
		<EnableNUnitRunner>true</EnableNUnitRunner>
		<!-- Set the output type to Exe to allow running the tests as a console application. -->
		<OutputType>Exe</OutputType>
		<!-- Pass coverlet options via MSBuild. This allows using MSBuild variables. -->
		<TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --coverlet-file-prefix $(MSBuildProjectName)</TestingPlatformCommandLineArguments>
		
	</PropertyGroup>

	<ItemGroup>
		<!-- General packages -->
		<PackageReference Include="AutoFixture.AutoMoq" Version="4.18.1" />
		<PackageReference Include="coverlet.MTP" Version="10.0.1" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="NUnit" Version="4.5.1" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
		<PackageReference Include="NunitXml.TestLogger" Version="8.0.0" />
		
		<!-- Specific packages -->
		<!-- Add any specific packages for this test project here -->
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plc.Implementation.Test\Plc.Implementation.Test.csproj" />
		<ProjectReference Include="..\..\Plc.Mock\Plc.Mock.csproj" />
	</ItemGroup>

</Project>