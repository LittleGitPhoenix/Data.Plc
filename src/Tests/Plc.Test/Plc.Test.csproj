<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<AssemblyName>Phoenix.Data.Plc.Test</AssemblyName>
		<RootNamespace>Phoenix.Data.Plc.Test</RootNamespace>
		<Authors>Felix Leistner</Authors>
		<Company>Little Phoenix</Company>
		
		<!--
		# ╔═══════════════════════════════╗
		# ║ Microsoft Test Platform (MTP) ║
		# ╚═══════════════════════════════╝
		-->
		<!-- Activates the NUnit runner extension inside MTP. This extension generates a Main method and allows the test project to run as a standalone executable if OutputType is also enabled. -->
		<EnableNUnitRunner>true</EnableNUnitRunner>
		<!-- Set the output type to Exe to allow running the tests as a console application. -->
		<OutputType>Exe</OutputType>
		<!-- Pass coverlet options via MSBuild. This allows using MSBuild variables. -->
		<TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --coverlet-file-prefix $(MSBuildProjectName)</TestingPlatformCommandLineArguments>
		
	</PropertyGroup>

	<ItemGroup>
		<!-- General packages -->
		<PackageReference Include="AutoFixture.AutoMoq" Version="4.18.1" />
		<PackageReference Include="coverlet.MTP" Version="10.1.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="Moq" Version="4.21.0" />
		<PackageReference Include="NUnit" Version="5.0.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
		<PackageReference Include="NunitXml.TestLogger" Version="8.1.0" />
		
		<!-- Specific packages -->
		<PackageReference Include="morelinq" Version="4.4.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Plc.Monitor.Polling\Plc.Monitor.Polling.csproj" />
		<ProjectReference Include="..\..\Plc.Monitor\Plc.Monitor.csproj" />
		<ProjectReference Include="..\..\Plc\Plc.csproj" />
	</ItemGroup>

</Project>