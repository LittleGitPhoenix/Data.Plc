<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<RootNamespace>Phoenix.Data.Plc.SiAccess</RootNamespace>
		<AssemblyName>Phoenix.Data.Plc.SiAccess.Demo</AssemblyName>
		<Copyright>2026</Copyright>
		<Version>7.0.0-RC.1</Version>
		<Authors>Felix Leistner</Authors>
		<Company>Little Phoenix</Company>
		<Description>Provides plc communication via siAccess demo assemblies.</Description>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<PackageIcon>nuget.png</PackageIcon>
		<PackageIconUrl>https://www.little-phoenix.de/nuget/nuget.ico</PackageIconUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageTags>plc;siaccess;communication</PackageTags>
		<NoWarn>NU5048</NoWarn>
		<NoWarn>NU5100</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Plc.SiAccess\Plc.SiAccess.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\nuget.png" Pack="true" PackagePath="" Link="⬙\nuget.png" />
		<None Include="..\..\README.md" Pack="true" PackagePath="" Link="⬙\README.md" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="" Link="⬙\LICENSE.md" />
		<None Include="..\..\COPYING" Pack="true" PackagePath="" Link="⬙\COPYING" />
		<None Include="..\..\COPYING.LESSER" Pack="true" PackagePath="" Link="⬙\COPYING.LESSER" />
	</ItemGroup>

	<!-- Reference the siAccess .NET wrapper assembly. -->
	<ItemGroup>
		<Reference Include="⬙\siAccess\siAccess_DotNET.dll" />
		<!--
		The wrapper assembly needs to be put into the lib folder of EVERY target framework.
		Otherwise it won't be part of the debs.json which then leads to an TypeInitializationException during runtime of consuming projects.
		The reason is that siAccess_DotNET.dll can't be found, even when it is in the root of the output folder of the consuming project.
		-->
		<!--<None Include="Resources\siAccess\siAccess_DotNET.dll" Pack="true" PackagePath="lib\net45" />-->
		<None Include="⬙\siAccess\siAccess_DotNET.dll" Pack="true" PackagePath="lib\netstandard2.0" />
		<!--<None Include="Resources\siAccess\siAccess_DotNET.dll" Pack="true" PackagePath="lib\net5.0" />-->
	</ItemGroup>

	<!-- Embedded resoures. -->
	<ItemGroup>
		<EmbeddedResource Include="⬙\siAccess\siAccess.license" />
		<EmbeddedResource Include="⬙\siAccess\siAccess_Error.txt" />
		<EmbeddedResource Include="⬙\siAccess\siAccess_x86.dll" />
		<EmbeddedResource Include="⬙\siAccess\siAccess_x64.dll" />
	</ItemGroup>

	<!-- Move the created NuGet packages into another folder. -->
	<Target Name="MovePackage" AfterTargets="Pack">
		<Move SourceFiles="$(BaseOutputPath)$(Configuration)\$(PackageId).$(PackageVersion).symbols.nupkg" DestinationFiles="$(MSBuildProjectDirectory)\..\..\.nuget\$(PackageId).$(PackageVersion).nupkg" />
		<Delete Files="$(BaseOutputPath)$(Configuration)\$(PackageId).$(PackageVersion).nupkg" />
	</Target>

</Project>